# /etc/profile -- Antigravity Android environment login setup.
# PREFIX is normally exported by the app; otherwise derive it from this file.
if [ -z "${PREFIX:-}" ]; then
    _agy_self="${BASH_SOURCE[0]:-$0}"
    PREFIX="$(cd "$(dirname "$_agy_self")/.." 2>/dev/null && pwd)"
    unset _agy_self
fi
export PREFIX

if [ -d "$PREFIX/etc/profile.d" ]; then
    for _agy_f in "$PREFIX/etc/profile.d"/*.sh; do
        [ -r "$_agy_f" ] && . "$_agy_f"
    done
    unset _agy_f
fi
